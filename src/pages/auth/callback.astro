---
import Layout from '../../layouts/Layout.astro';

// Check for errors in URL params (server-side)
const url = new URL(Astro.request.url);
const error = url.searchParams.get('error');
const errorDescription = url.searchParams.get('error_description');

// If there's an OAuth error, redirect immediately
if (error) {
  const errorMessage = errorDescription || error;
  return Astro.redirect(`/auth/signin?error=${encodeURIComponent(errorMessage)}`);
}
---

<Layout title="Signing in... - 1DAY">
  <div class="callback-page">
    <div class="callback-content">
      <div class="callback-spinner"></div>
      <h1 class="callback-title">Completing sign in...</h1>
      <p class="callback-text">Please wait while we verify your credentials.</p>
      <p id="debug-info" class="callback-debug"></p>
    </div>
  </div>
</Layout>

<script>
  import { supabase } from '../../lib/supabase';

  async function handleCallback() {
    const debugEl = document.getElementById('debug-info');
    const updateDebug = (msg: string) => {
      if (debugEl && import.meta.env.DEV) {
        debugEl.textContent = msg;
      }
    };

    try {
      // Check URL for authorization code (PKCE flow)
      const url = new URL(window.location.href);
      const code = url.searchParams.get('code');
      const hashParams = new URLSearchParams(window.location.hash.substring(1));
      const accessToken = hashParams.get('access_token');

      updateDebug(`Code: ${code ? 'yes' : 'no'}, Token: ${accessToken ? 'yes' : 'no'}`);

      // PKCE Flow: Exchange authorization code for session
      if (code) {
        updateDebug('Exchanging code for session...');
        
        const { data, error } = await supabase.auth.exchangeCodeForSession(code);
        
        if (error) {
          updateDebug(`Exchange error: ${error.message}`);
          
          // Maybe the code was already exchanged, check for existing session
          const { data: { session } } = await supabase.auth.getSession();
          if (session) {
            updateDebug('Found existing session, redirecting...');
            window.location.replace('/app');
            return;
          }
          
          window.location.replace('/auth/signin?error=' + encodeURIComponent(error.message));
          return;
        }
        
        if (data?.session) {
          updateDebug('Session established, redirecting...');
          // Use replace to prevent back button issues
          window.location.replace('/app');
          return;
        }
      }

      // Implicit Flow fallback: Token in hash
      if (accessToken) {
        updateDebug('Processing hash token...');
        
        // Wait for Supabase to process the hash automatically
        await new Promise(resolve => setTimeout(resolve, 500));
        
        const { data: { session } } = await supabase.auth.getSession();
        if (session) {
          window.location.replace('/app');
          return;
        }
      }

      // No code or token - check for existing session
      updateDebug('Checking for existing session...');
      const { data: { session } } = await supabase.auth.getSession();
      
      if (session) {
        updateDebug('Found session, redirecting...');
        window.location.replace('/app');
        return;
      }

      // No session found
      updateDebug('No session found, redirecting to sign in...');
      await new Promise(resolve => setTimeout(resolve, 500));
      window.location.replace('/auth/signin');
      
    } catch (err) {
      const message = err instanceof Error ? err.message : 'Authentication failed';
      updateDebug(`Error: ${message}`);
      
      // Try one more time to get session
      try {
        const { data: { session } } = await supabase.auth.getSession();
        if (session) {
          window.location.replace('/app');
          return;
        }
      } catch {
        // Ignore
      }
      
      window.location.replace('/auth/signin?error=' + encodeURIComponent(message));
    }
  }

  // Run immediately
  handleCallback();
</script>

<style>
  .callback-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .callback-content {
    text-align: center;
  }

  .callback-spinner {
    width: 32px;
    height: 32px;
    border: 2px solid var(--color-border);
    border-top-color: white;
    border-radius: 50%;
    animation: spin 1s linear infinite;
    margin: 0 auto 1.5rem;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .callback-title {
    font-size: 1.25rem;
    font-weight: 400;
    color: white;
    margin-bottom: 0.5rem;
  }

  .callback-text {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .callback-debug {
    margin-top: 1rem;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    font-family: monospace;
  }
</style>
