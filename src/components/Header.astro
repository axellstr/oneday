---
import UserMenu from './UserMenu';

interface Props {
  title?: string;
  showBack?: boolean;
  minimal?: boolean;
  showAuth?: boolean;
}

const { title = '1Day', showBack = false, minimal = false, showAuth = true } = Astro.props;
---

<header class={`header ${minimal ? 'header-transparent' : 'header-default'}`}>
  <div class="header-inner">
    <div class="flex items-center gap-3">
      {showBack && (
        <a href="/app" class="header-back">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m15 18-6-6 6-6"/>
          </svg>
        </a>
      )}
      <a href="/" class="header-logo">
        <span class="opacity-50 mr-1">律</span><span class="font-bold">1</span>DAY
      </a>
    </div>
    <div class="flex items-center gap-3">
      <slot name="actions" />
      {showAuth && <UserMenu client:load />}
    </div>
  </div>
</header>
