{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/app/dashboard/?$",
			"dest": "_render"
		},
		{
			"src": "^/app/habit/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/app/settings/?$",
			"dest": "_render"
		},
		{
			"src": "^/app/?$",
			"dest": "_render"
		},
		{
			"src": "^/auth/callback/?$",
			"dest": "_render"
		},
		{
			"src": "^/auth/profile/?$",
			"dest": "_render"
		},
		{
			"src": "^/auth/signin/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		}
	]
}