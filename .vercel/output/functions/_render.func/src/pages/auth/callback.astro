---
import Layout from '../../layouts/Layout.astro';

// Check for errors in URL params (server-side)
const url = new URL(Astro.request.url);
const error = url.searchParams.get('error');
const errorDescription = url.searchParams.get('error_description');

// If there's an OAuth error, redirect immediately
if (error) {
  const errorMessage = errorDescription || error;
  return Astro.redirect(`/auth/signin?error=${encodeURIComponent(errorMessage)}`);
}
---

<Layout title="Signing in... - 1Day">
  <div class="callback-page">
    <div class="callback-content">
      <div class="callback-spinner"></div>
      <h1 class="callback-title">Completing sign in...</h1>
      <p class="callback-text">Please wait while we verify your credentials.</p>
    </div>
  </div>
</Layout>

<script>
  import { supabase } from '../../lib/supabase';

  async function handleCallback() {
    console.log('Callback: Starting auth flow...');
    console.log('Callback: URL hash:', window.location.hash);
    
    try {
      // With implicit flow, tokens are in the URL hash
      // The Supabase client should detect and process them automatically
      // But we need to ensure it happens before we check the session
      
      // First, let's manually check if there's a hash with tokens
      if (window.location.hash) {
        console.log('Callback: Hash detected, waiting for Supabase to process...');
        
        // Wait for Supabase to process the hash
        // The onAuthStateChange will fire when session is established
        return new Promise<void>((resolve) => {
          const timeout = setTimeout(() => {
            console.log('Callback: Timeout waiting for auth');
            window.location.href = '/auth/signin?error=timeout';
            resolve();
          }, 10000);
          
          const { data: { subscription } } = supabase.auth.onAuthStateChange((event, session) => {
            console.log('Callback: Auth state changed:', event, !!session);
            
            if (event === 'SIGNED_IN' && session) {
              clearTimeout(timeout);
              subscription.unsubscribe();
              console.log('Callback: Signed in, redirecting to app...');
              window.location.href = '/app';
              resolve();
            }
          });
        });
      }
      
      // No hash - check if we already have a session
      console.log('Callback: No hash, checking existing session...');
      const { data: { session }, error } = await supabase.auth.getSession();
      
      if (error) {
        console.error('Callback: Session error:', error);
        window.location.href = '/auth/signin?error=' + encodeURIComponent(error.message);
        return;
      }
      
      if (session) {
        console.log('Callback: Session found, redirecting to app...');
        window.location.href = '/app';
        return;
      }
      
      // No session - redirect to sign in
      console.log('Callback: No session, redirecting to signin...');
      window.location.href = '/auth/signin';
      
    } catch (err) {
      console.error('Callback error:', err);
      window.location.href = '/auth/signin?error=callback_failed';
    }
  }

  handleCallback();
</script>

<style>
  .callback-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .callback-content {
    text-align: center;
  }

  .callback-spinner {
    width: 32px;
    height: 32px;
    border: 2px solid var(--color-border);
    border-top-color: white;
    border-radius: 50%;
    animation: spin 1s linear infinite;
    margin: 0 auto 1.5rem;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .callback-title {
    font-size: 1.25rem;
    font-weight: 400;
    color: white;
    margin-bottom: 0.5rem;
  }

  .callback-text {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }
</style>
